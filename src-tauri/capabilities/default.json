{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",

    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",

    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat",

    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" },

        { "path": "$HOME/**/.*" },
        { "path": "$HOME/**/.*/**" },
        { "path": "$APPDATA/**/.*" },
        { "path": "$APPDATA/**/.*/**" },
        { "path": "$APPLOCALDATA/**/.*" },
        { "path": "$APPLOCALDATA/**/.*/**" },
        { "path": "$DOCUMENT/**/.*" },
        { "path": "$DOCUMENT/**/.*/**" },
        { "path": "$DESKTOP/**/.*" },
        { "path": "$DESKTOP/**/.*/**" },
        { "path": "$DOWNLOAD/**/.*" },
        { "path": "$DOWNLOAD/**/.*/**" }
      ]
    },

    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://api.openai.com/*" },
        { "url": "https://api.anthropic.com/*" }
      ]
    }
  ]
}
